	version(2);
project_name = "magpie";

patterns = {
	"*.c",
	"*.cpp",
	"*.h",
	"*.m",
	"*.inc",
	"*.bat",
	"*.sh",
	"*.4coder",
	"*.slang",
};

blacklist_patterns = {
	".*",
};

load_paths_base = {
	{ ".", .relative = true, .recursive = true, },
};

load_paths = {
	.win = load_paths_base,
	.linux = load_paths_base,
	.mac = load_paths_base,
};

commands = {
	.build = {
		.out = "*compilation*",
		.footer_panel = true,
		.save_dirty_files = true,
		.win = "build.bat",
		.linux = "./build.sh",
		.mac = "./build.sh",
	},
	.run = {
		.out = "*run*",
		.footer_panel = false,
		.save_dirty_files = false,
		.win = "build\\magpie_win32",
		.linux = "build/magpie_linux",
		.mac = "build/magpie_macos",
	},
};

fkey_command = {
	.F1 = "build",
	.F2 = "run",
};
